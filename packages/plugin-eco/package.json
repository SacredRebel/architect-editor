{
  "name": "@eco/plugin-eco",
  "version": "0.1.0",
  "description": "Eco world-bridge plugin for the Pascal editor fork — site overlay, embed protocol, GLB walk export.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bridge-types": {
      "types": "./src/bridge-types.ts",
      "default": "./src/bridge-types.ts"
    }
  },
  "files": [
    "src",
    "test",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "bun test src",
    "check:glb": "bun test/check-glb-h1.mjs",
    "check:export": "bun test/check-export.mjs",
    "check:roundtrip": "bun test/check-roundtrip.mjs",
    "check:trees": "bun test/check-trees.mjs"
  },
  "peerDependencies": {
    "@pascal-app/core": "^1.0.1",
    "@pascal-app/editor": "^1.0.1",
    "@pascal-app/viewer": "^1.0.1",
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "three": "^0.186"
  },
  "devDependencies": {
    "@pascal-app/core": "^1.0.1",
    "@pascal-app/editor": "^1.0.1",
    "@pascal-app/viewer": "^1.0.1",
    "@pascal/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "@types/react": "19.2.2",
    "@types/three": "^0.184.0",
    "three": "^0.186.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SacredRebel/architect-editor.git",
    "directory": "packages/plugin-eco"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@react-three/rapier": "^2.2.0",
    "draco3dgltf": "^1.5.7",
    "ecctrl": "^2.0.2",
    "meshoptimizer": "^0.22.0"
  }
}
